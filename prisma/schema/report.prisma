// One row per missionary, so a request sent to everyone can be answered by each.
model ReportRequest {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  dueDate   DateTime?
  createdAt DateTime          @default(now())
  report    MissionaryReport?

  @@index([userId])
  @@index([createdAt])
  @@map("report_request")
}

model MissionaryReport {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestId String?        @unique
  request   ReportRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  title     String
  body      String
  createdAt DateTime       @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("missionary_report")
}
